<?xml version="1.0"?>
<!--
  占位模型（T02）：单个 box 立方体 link + 一个 fixed 关节。
  官方 RM75-B 资产属 S01，本文件**不使用**任何官方资产。

  注意：关节的 parent 使用**本 URDF 内的 link**（模型自包含约定）。
  挂到世界（parent link="world"）在 Drake 上本身可行（实测加载成功），
  但本项目约定用场景层的 base_extrinsics 表达挂载位姿（S02 填充），
  因此 URDF 不直接挂 world。
-->
<robot name="rm75_drake_placeholder">
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 0.1 0.1"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.1 0.1 0.1"/>
      </geometry>
    </collision>
  </link>

  <link name="tip_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.001" ixy="0.0" ixz="0.0" iyy="0.001" iyz="0.0" izz="0.001"/>
    </inertial>
  </link>

  <joint name="base_to_tip" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="tip_link"/>
  </joint>
</robot>
