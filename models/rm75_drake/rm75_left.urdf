  <!--
    相邻 link 对的显式碰撞禁用声明（7 组，父子直接相连的 body 对）。
    说明见文件头：Drake 1.51.1 / 1.55.0 不实现本标签，实际生效的是 Drake
    默认的父子相邻体过滤；本块是声明性意图 + 未来兼容的安全写法
    （default_collide="true" = 默认碰撞、显式禁用这 7 组）。
    禁止写 link="world"（基座由装配层 weld 固定）。
  -->
  <drake:disable_collision default_collide="true">
    <drake:disable_collide link1="left_base_link" link2="left_link_1" />
    <drake:disable_collide link1="left_link_1" link2="left_link_2" />
    <drake:disable_collide link1="left_link_2" link2="left_link_3" />
    <drake:disable_collide link1="left_link_3" link2="left_link_4" />
    <drake:disable_collide link1="left_link_4" link2="left_link_5" />
    <drake:disable_collide link1="left_link_5" link2="left_link_6" />
    <drake:disable_collide link1="left_link_6" link2="left_link_7" />
  </drake:disable_collision>
</robot>
